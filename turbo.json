{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "npm_config_cache",
    "NEXT_TELEMETRY_DISABLED",
    "TZ"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_LOCAL_AUTH_MODE",
        "EXPO_PUBLIC_HOSTED_AUTH_MODE",
        "EXPO_PUBLIC_HOSTED_AUTH_TERMS_VERSION",
        "EXPO_PUBLIC_HOSTED_AUTH_TERMS_URL",
        "EXPO_PUBLIC_HOSTED_AUTH_PRIVACY_URL",
        "NEXT_PUBLIC_DEMO_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_URL", "PG_TEST_DATABASE_URL", "TZ"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL", "PG_TEST_DATABASE_URL", "TZ"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DEMO_MODE",
        "LOCAL_AUTH_MODE",
        "LOCAL_AUTH_BASE_URL",
        "LOCAL_AUTH_SECRET",
        "EXPO_PUBLIC_LOCAL_AUTH_MODE",
        "EXPO_PUBLIC_HOSTED_AUTH_MODE",
        "EXPO_PUBLIC_HOSTED_AUTH_TERMS_VERSION",
        "EXPO_PUBLIC_HOSTED_AUTH_TERMS_URL",
        "EXPO_PUBLIC_HOSTED_AUTH_PRIVACY_URL",
        "POSTGRES_OPERATIONS_CONFIG_FILE",
        "POSTGRES_BACKUP_SIGNING_KEY_FILE",
        "API_HOST",
        "API_PORT",
        "DATABASE_URL",
        "DATABASE_RUNTIME_URL",
        "PGLITE_PATH",
        "LOCAL_KEY_VAULT_PATH",
        "SOURCE_ERASURE_JOURNAL_PATH",
        "DELETION_JOURNAL_KEY_FILE",
        "DELETION_JOURNAL_KEY_ID",
        "EXPO_PUBLIC_API_URL",
        "NEXT_PUBLIC_DEMO_URL",
        "EXPO_OFFLINE",
        "EXPO_NO_TELEMETRY",
        "CI",
        "PAYLOAD_RETENTION_ENABLED",
        "PAYLOAD_RETENTION_INTERVAL_MS",
        "PAYLOAD_RETENTION_PROFILE_LIMIT",
        "PAYLOAD_RETENTION_PAYLOAD_LIMIT"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
