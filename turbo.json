{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "npm_config_cache",
    "NEXT_TELEMETRY_DISABLED",
    "TZ"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_URL", "PG_TEST_DATABASE_URL", "TZ"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL", "PG_TEST_DATABASE_URL", "TZ"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DEMO_MODE",
        "API_HOST",
        "API_PORT",
        "DATABASE_URL",
        "PGLITE_PATH",
        "EXPO_PUBLIC_API_URL",
        "EXPO_OFFLINE",
        "EXPO_NO_TELEMETRY",
        "CI"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
