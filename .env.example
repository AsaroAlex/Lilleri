# Synthetic development only. Production startup fails closed.
DEMO_MODE=1
API_HOST=127.0.0.1
API_PORT=3001
# Optional; default is the ignored repository .lilleri/data directory.
# PGLITE_PATH=/absolute/path/to/local/demo-data
# Optional PostgreSQL connection for the same schema; no bank credentials.
# DATABASE_URL=postgresql://lilleri_demo:local_demo_only@127.0.0.1:5432/lilleri_demo
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001

# Optional, mutually exclusive local browser identity for SYNTHETIC data only.
# Obtain a stable >=32-character LOCAL_AUTH_SECRET through secure environment settings.
# Do not commit it, print it or pass it through a network-proxy secret binding.
# DEMO_MODE=0
# LOCAL_AUTH_MODE=1
# LOCAL_AUTH_BASE_URL=http://localhost:3001
# LOCAL_AUTH_SECRET must be supplied securely; there is no checked-in default.
# EXPO_PUBLIC_LOCAL_AUTH_MODE=1
# EXPO_PUBLIC_API_URL=http://localhost:3001
# Use localhost for both browser and API in cookie mode. Native auth is not validated.

# Same-handle automatic cleanup of expired synthetic raw payloads.
# PAYLOAD_RETENTION_ENABLED=1
# PAYLOAD_RETENTION_INTERVAL_MS=60000
# PAYLOAD_RETENTION_PROFILE_LIMIT=20
# PAYLOAD_RETENTION_PAYLOAD_LIMIT=100
