    "@lilleri/brand": "workspace:*",
    "@lilleri/domain": "workspace:*",
    "@lilleri/money": "workspace:*",
    "better-auth": "1.7.7",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.12",
