{
  "name": "lilleri",
  "version": "0.0.0",
  "private": true,
  "description": "Lilleri — connect your accounts once, your finances organise themselves.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "predev": "turbo run build --filter=@lilleri/api --filter=@lilleri/api-client --filter=@lilleri/brand",
    "dev": "turbo run dev",
    "dev:cloud": "node tools/dev/run.mjs",
    "test:dev": "node --test tools/dev/dev.test.mjs",
    "preview:build": "node tools/preview/build.mjs",
    "preview:start": "node tools/preview/run.mjs",
    "test:preview": "node --test tools/preview/static.test.mjs",
    "test:postgres-operations": "node --test tools/postgres-operations.test.mjs",
    "check:hosted": "node tools/hosted-readiness.mjs",
    "check:sandbox": "pnpm --filter @lilleri/financial-providers sandbox:check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:configuration": "node tools/lint-operational-configuration.mjs",
    "test:configuration-lint": "node --test tools/lint-operational-configuration.test.mjs",
    "check": "biome check . && pnpm test:configuration-lint && pnpm lint:configuration && pnpm test:copy-lint && pnpm lint:copy && pnpm test:evaluation-contract && pnpm test:bootstrap && pnpm test:dev && pnpm test:preview && pnpm test:postgres-operations && turbo run typecheck test",
    "check:fix": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "simple-git-hooks || true",
    "lint:copy": "node tools/lint-ui-copy.mjs",
    "test:copy-lint": "node --test tools/lint-ui-copy.test.mjs",
    "test:evaluation-contract": "node --test tools/evaluation/evaluation.test.mjs",
    "evaluate:shadow": "node tools/evaluation/run.mjs",
    "dev:zero": "node tools/bootstrap/run.mjs --prepare",
    "check:zero": "node tools/bootstrap/run.mjs --check",
    "economics:zero": "node tools/bootstrap/report.mjs",
    "test:bootstrap": "node --test tools/bootstrap/bootstrap.test.mjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.19.0",
    "simple-git-hooks": "2.14.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched",
    "commit-msg": "node scripts/check-commit-msg.mjs \"$1\""
  },
  "pnpm": {
    "overrides": {
      "xcode@3.0.1>uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "simple-git-hooks",
      "esbuild",
      "@biomejs/biome"
    ]
  }
}
